rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerEmail(email) {
      return isSignedIn() && request.auth.token.email == email;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'joaovs.goncalves1@gmail.com';
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /chats/{userEmail}/messages/{messageId} {
      allow read, write: if isOwnerEmail(userEmail);
    }

    match /StudentProfile/{docId} {
      allow read: if isSignedIn() && (
        resource.data.email == request.auth.token.email || isAdmin()
      );
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (
        isSignedIn() && resource.data.email == request.auth.token.email
      );
    }

    match /Routine/{docId} {
      allow read: if isSignedIn() && (
        resource.data.student_email == request.auth.token.email || isAdmin()
      );
      allow write: if isAdmin() || (
        isSignedIn() && request.resource.data.student_email == request.auth.token.email
      );
    }

    match /RoutineExercise/{docId} {
      allow read, write: if isSignedIn();
    }

    match /Exercise/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /WorkoutSession/{docId} {
      allow read, create: if isSignedIn() && (
        request.resource.data.student_email == request.auth.token.email || isAdmin()
      );
      allow update: if isSignedIn() && (
        resource.data.student_email == request.auth.token.email || isAdmin()
      );
    }

    match /SetLog/{docId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /Checkin/{docId} {
      allow read: if isSignedIn() && (
        resource.data.student_email == request.auth.token.email || isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.student_email == request.auth.token.email;
    }

    match /BodyMeasurement/{docId} {
      allow read, write: if isSignedIn() && (
        resource.data.student_email == request.auth.token.email || isAdmin()
      );
    }

    match /LevelConfig/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /XPConfig/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}