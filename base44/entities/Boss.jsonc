      "description": "Nome do chefe"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do chefe"
    },
    "skill_id": {
      "type": "string",
      "description": "ID da skill associada"
    },
    "hp_total": {
      "type": "number",
      "description": "HP total do chefe"
    },
    "xp_bonus": {
      "type": "number",
