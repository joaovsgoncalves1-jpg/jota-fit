{
  "name": "Exercise",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do exerc\u00edcio"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o simples"
    },
    "movement_pattern": {
      "type": "string",
      "enum": [
        "puxar",
        "empurrar",
        "core",
        "pernas",
        "mobilidade",
        "skill"
      ],
      "description": "Padr\u00e3o de movimento"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ],
      "description": "N\u00edvel de dificuldade"
    },
    "equipment_needed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Equipamentos: sem_equipamento, barra, paralelas, elastico, argolas"
    },
    "muscle_groups": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Grupos musculares trabalhados"
    },
    "tips": {
      "type": "string",
      "description": "Dica de execu\u00e7\u00e3o"
    },
    "common_mistakes": {
      "type": "string",
      "description": "Erros comuns"
    },
    "sets_recommended": {
      "type": "string",
      "description": "Ex: 3x10-12"
    },
    "rest_seconds": {
      "type": "number",
      "description": "Descanso sugerido em segundos"
    },
    "video_url": {
      "type": "string",
      "description": "URL do YouTube"
    },
    "image_url": {
      "type": "string",
      "description": "URL da imagem"
    }
  },
  "required": [
    "name"
  ]
}