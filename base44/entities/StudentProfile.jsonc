{
  "name": "StudentProfile",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email do aluno"
    },
    "name": {
      "type": "string",
      "description": "Nome do aluno"
    },
    "avatar_url": {
      "type": "string",
      "description": "URL do avatar"
    },
    "xp_total": {
      "type": "number",
      "default": 0,
      "description": "XP total acumulado"
    },
    "current_streak": {
      "type": "number",
      "default": 0,
      "description": "Streak atual em dias"
    },
    "max_streak": {
      "type": "number",
      "default": 0,
      "description": "Maior streak alcan\u00e7ado"
    },
    "last_checkin_date": {
      "type": "string",
      "format": "date",
      "description": "Data do \u00faltimo check-in"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "fitness_level": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ],
      "description": "N\u00edvel de aptid\u00e3o f\u00edsica"
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Objetivos do aluno"
    },
    "training_days": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Dias da semana de treino"
    },
    "preferred_time": {
      "type": "string",
      "description": "Hor\u00e1rio preferido de treino"
    },
    "weight_kg": {
      "type": "number",
      "description": "Peso atual em kg"
    },
    "target_weight_kg": {
      "type": "number",
      "description": "Peso objetivo em kg"
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false,
      "description": "Onboarding conclu\u00eddo"
    }
  },
  "required": [
    "email",
    "name"
  ]
}