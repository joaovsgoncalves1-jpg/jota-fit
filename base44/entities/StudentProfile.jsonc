{
  "name": "StudentProfile",
  "type": "object",
  "properties": {
    "email": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "xp_total": {
      "type": "number",
      "default": 0
    },
    "current_streak": {
      "type": "number",
      "default": 0
    },
    "max_streak": {
      "type": "number",
      "default": 0
    },
    "last_checkin_date": {
      "type": "string",
      "format": "date"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "fitness_level": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "training_days": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preferred_time": {
      "type": "string"
    },
    "weight_kg": {
      "type": "number"
    },
    "target_weight_kg": {
      "type": "number"
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false
    },
    "plan_type": {
      "type": "string",
      "enum": [
        "free",
        "pro",
        "premium"
      ],
      "default": "free"
    },
    "plan_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "stripe_subscription_id": {
      "type": "string"
    }
  },
  "required": [
    "email",
    "name"
  ]
}