{
  "name": "Notification",
  "type": "object",
  "properties": {
    "student_email": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "achievement",
        "mission",
        "workout_reminder",
        "challenge",
        "admin_message",
        "streak"
      ]
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "action_url": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    }
  },
  "required": [
    "student_email",
    "title"
  ]
}