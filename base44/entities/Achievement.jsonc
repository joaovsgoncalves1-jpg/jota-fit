{
  "name": "Achievement",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome da conquista"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da conquista"
    },
    "icon": {
      "type": "string",
      "description": "Nome do \u00edcone"
    },
    "trigger_type": {
      "type": "string",
      "enum": [
        "first_workout",
        "first_checkin",
        "first_boss",
        "streak_7",
        "streak_30",
        "level_5",
        "level_10",
        "skills_3",
        "skills_10",
        "workouts_10",
        "workouts_50",
        "custom"
      ],
      "description": "Tipo de gatilho"
    },
    "trigger_value": {
      "type": "number",
      "description": "Valor do gatilho (para custom)"
    },
    "xp_reward": {
      "type": "number",
      "default": 100,
      "description": "XP de recompensa"
    },
    "rarity": {
      "type": "string",
      "enum": [
        "common",
        "rare",
        "epic",
        "legendary"
      ],
      "default": "common"
    }
  },
  "required": [
    "name",
    "trigger_type"
  ]
}