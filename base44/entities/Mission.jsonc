{
  "name": "Mission",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome da miss\u00e3o"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da miss\u00e3o"
    },
    "condition_type": {
      "type": "string",
      "enum": [
        "workouts_completed",
        "streak_days",
        "bosses_defeated",
        "checkins_completed",
        "xp_earned"
      ],
      "description": "Tipo de condi\u00e7\u00e3o"
    },
    "condition_value": {
      "type": "number",
      "description": "Valor alvo da condi\u00e7\u00e3o"
    },
    "xp_reward": {
      "type": "number",
      "default": 300,
      "description": "XP de recompensa"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "for_all": {
      "type": "boolean",
      "default": true,
      "description": "Se \u00e9 para todos os alunos"
    },
    "target_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails dos alunos alvo (se n\u00e3o for para todos)"
    }
  },
  "required": [
    "name",
    "condition_type",
    "condition_value"
  ]
}