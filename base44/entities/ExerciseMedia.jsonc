{
  "name": "ExerciseMedia",
  "type": "object",
  "properties": {
    "exercise_id": {
      "type": "string",
      "description": "ID do exerc\u00edcio"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "gif",
        "video",
        "image",
        "thumbnail"
      ],
      "description": "Tipo de m\u00eddia"
    },
    "url": {
      "type": "string",
      "description": "URL da m\u00eddia"
    },
    "source": {
      "type": "string",
      "description": "Fonte (youtube, giphy, instagram, original)"
    },
    "license_info": {
      "type": "string",
      "description": "Informa\u00e7\u00f5es de licen\u00e7a"
    },
    "is_jota_original": {
      "type": "boolean",
      "default": false,
      "description": "Conte\u00fado original do Jota"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o"
    },
    "is_primary": {
      "type": "boolean",
      "default": false,
      "description": "M\u00eddia principal do exerc\u00edcio"
    }
  },
  "required": [
    "exercise_id",
    "media_type",
    "url"
  ]
}