# ─── Base44 (padrão — app continua funcionando) ───
VITE_BASE44_APP_ID=
VITE_BASE44_APP_BASE_URL=

# Dados: false = Base44 (padrão) | true = Firestore (auth ainda Base44)
VITE_USE_FIREBASE_DATA=false
# Legado (equivalente a VITE_USE_FIREBASE_DATA=true)
VITE_DATA_BACKEND=base44

# Chat IA do Jota (opcional — precisa Firebase + npm run dev:own)
VITE_ENABLE_JOTA_CHAT=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# Servidor local (npm run dev:own)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
PORT=3000